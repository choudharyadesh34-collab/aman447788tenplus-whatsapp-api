# TenPlus WhatsApp API production template
# Copy to .env and replace every CHANGE_ME value before starting.
NODE_ENV=production
PORT=2785
API_PORT=2785
BIND_HOST=127.0.0.1
LOG_LEVEL=info
LOG_FORMAT=json
SERVE_DASHBOARD=true
BASE_URL=https://wa-api.example.com
DASHBOARD_URL=https://wa-api.example.com
CORS_ORIGINS=https://wa-api.example.com
ENGINE_TYPE=whatsapp-web.js
AUTO_START_SESSIONS=true

# Conservative guardrails for a dedicated, opted-in business number.
SIMULATE_TYPING=true
SIMULATE_TYPING_MAX_MS=5000
SEND_PACING_ENABLED=true
SEND_PACING_WARMUP_SCHEDULE=20,40,80,160,320,640,1000
SEND_PACING_COLD_DAILY_CAP=5,10,20,40,60,80,100
SEND_PACING_BREAKER_THRESHOLD=5
SEND_PACING_BREAKER_COOLDOWN_MS=900000

# Generate each with: openssl rand -hex 32
# API_MASTER_KEY is the initial dashboard/admin credential.
API_MASTER_KEY=CHANGE_ME_TO_A_RANDOM_64_CHARACTER_SECRET
API_KEY_PEPPER=CHANGE_ME_TO_A_DIFFERENT_RANDOM_64_CHARACTER_SECRET

# Keep the single-instance defaults unless the server is sized for more sessions.
MAX_CONCURRENT_SESSIONS=1
OPENWA_MEM_LIMIT=2g
OPENWA_PIDS_LIMIT=2048
